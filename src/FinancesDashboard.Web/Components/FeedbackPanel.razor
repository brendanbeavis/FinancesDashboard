@if (ShouldRender())
{
    <div class="@BuildClassName()" role="@GetRole()" aria-live="@GetAriaLive()">
        <div class="fd-feedback__content">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <div class="fd-feedback__title">@Title</div>
            }

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="fd-feedback__message">@Message</div>
            }

            @if (!string.IsNullOrWhiteSpace(Suggestion))
            {
                <div class="fd-feedback__suggestion">@Suggestion</div>
            }

            @if (ChildContent is not null)
            {
                <div class="fd-feedback__body">@ChildContent</div>
            }
        </div>

        @if (Actions is not null)
        {
            <div class="fd-feedback__actions">@Actions</div>
        }
    </div>
}

@code {
    [Parameter]
    public string Variant { get; set; } = "info";

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string? Suggestion { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    private bool ShouldRender()
    {
        return !string.IsNullOrWhiteSpace(Title)
            || !string.IsNullOrWhiteSpace(Message)
            || !string.IsNullOrWhiteSpace(Suggestion)
            || ChildContent is not null;
    }

    private string BuildClassName()
    {
        var classes = new List<string> { "fd-feedback", $"fd-feedback--{Variant.ToLowerInvariant()}" };

        if (!string.IsNullOrWhiteSpace(Class))
        {
            classes.Add(Class);
        }

        return string.Join(" ", classes);
    }

    private string GetRole()
    {
        return Variant.Equals("error", StringComparison.OrdinalIgnoreCase)
            ? "alert"
            : "status";
    }

    private string GetAriaLive()
    {
        return Variant.Equals("error", StringComparison.OrdinalIgnoreCase)
            ? "assertive"
            : "polite";
    }
}

@using Microsoft.AspNetCore.Components
@using System
@using System.Collections.Generic