@using FinancesDashboard.Web.Models

<div class="modal @(IsVisible ? "show" : "") fd-modal-backdrop" style="display: @(IsVisible ? "block" : "none");" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">Delete Transaction</h5>
                    <div class="text-muted small">Remove an imported transaction while keeping the action explicit and confirmable.</div>
                </div>
                <button type="button" class="btn-close" aria-label="Close" @onclick="HandleCancel" disabled="@IsDeleting"></button>
            </div>
            <div class="modal-body">
                @if (Transaction is not null)
                {
                    <p>Are you sure you want to delete this transaction? This action cannot be undone.</p>
                    <div class="alert alert-warning mb-0">
                        <strong>Transaction Details:</strong>
                        <dl class="row mb-0 mt-2">
                            <dt class="col-sm-4">Date:</dt>
                            <dd class="col-sm-8">@Transaction.Date.ToLongDateString()</dd>

                            <dt class="col-sm-4">Description:</dt>
                            <dd class="col-sm-8">@Transaction.Description</dd>

                            <dt class="col-sm-4">Amount:</dt>
                            <dd class="col-sm-8">
                                <span class="@(Transaction.Amount >= 0 ? "text-success" : "text-danger") fw-semibold">
                                    @Transaction.Amount.ToString("C")
                                </span>
                            </dd>

                            <dt class="col-sm-4">Bank Balance:</dt>
                            <dd class="col-sm-8">@Transaction.BankBalance.ToString("C")</dd>
                        </dl>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="alert alert-danger mt-3" role="alert">@ErrorMessage</div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="HandleCancel" disabled="@IsDeleting">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="HandleDelete" disabled="@IsDeleting">
                    @if (IsDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <span>Delete Transaction</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public TransactionModel? Transaction { get; set; }

    [Parameter]
    public EventCallback<bool> OnClose { get; set; }

    [Parameter]
    public EventCallback OnDeleteAsync { get; set; }

    private bool IsDeleting = false;
    private string? ErrorMessage { get; set; }

    private async Task HandleDelete()
    {
        IsDeleting = true;
        ErrorMessage = null;

        try
        {
            await OnDeleteAsync.InvokeAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error deleting transaction: {ex.Message}";
            IsDeleting = false;
        }
    }

    private async Task HandleCancel()
    {
        if (!IsDeleting)
        {
            await OnClose.InvokeAsync(false);
        }
    }
}
