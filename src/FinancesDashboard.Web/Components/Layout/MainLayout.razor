@inherits LayoutComponentBase
@inject ILogger<MainLayout> Logger
@inject ClientErrorLogger ErrorLogger

<div class="page-shell">
    <aside class="sidebar-shell">
        <NavMenu />
    </aside>

    <main class="main-shell">
        <header class="top-row-shell">
            <div class="top-row-shell__brand">
                <div class="top-row-shell__eyebrow">FinanceReport</div>
                <div class="top-row-shell__title">Finance instrumentation</div>
            </div>
            <div class="top-row-shell__meta">Monochrome reporting, transaction flow, and mortgage forecasting</div>
        </header>

        <section class="content-shell">
            @if (showErrorAlert && !string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show fd-inline-alert" role="alert">
                    <strong>Error:</strong> @errorMessage
                    <button type="button" class="btn-close" @onclick="DismissError"></button>
                </div>
            }

            <ErrorBoundary @ref="errorBoundary" ErrorContent="@RenderErrorContent">
                @Body
            </ErrorBoundary>
        </section>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private ErrorBoundary? errorBoundary;
    private bool showErrorAlert;
    private string? errorMessage;

    private RenderFragment RenderErrorContent(Exception ex) => builder =>
    {
        errorMessage = ex.Message;
        showErrorAlert = true;

        _ = ErrorLogger.LogExceptionAsync(ex, nameof(MainLayout));

        Logger.LogError(ex, "An unhandled error occurred in MainLayout");

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "alert alert-danger fd-inline-alert");
        builder.AddContent(2, $"An error occurred: {ex.Message}");
        builder.CloseElement();
    };

    private void DismissError()
    {
        showErrorAlert = false;
        errorMessage = null;
        errorBoundary?.Recover();
    }
}
