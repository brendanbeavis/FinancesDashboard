@page "/"

@inject FinancesApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

@if (isLoading)
{
    <p><em>Loading dashboard...</em></p>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card"><div class="card-body"><div class="text-muted">Net Position</div><div class="h4">@FormatCurrency(summary.CurrentNetPosition)</div></div></div>
        </div>
        <div class="col-md-3">
            <div class="card"><div class="card-body"><div class="text-muted">Cash</div><div class="h4">@FormatCurrency(summary.CurrentCashPosition)</div></div></div>
        </div>
        <div class="col-md-3">
            <div class="card"><div class="card-body"><div class="text-muted">Credit Card</div><div class="h4">@FormatCurrency(summary.CurrentCreditCardPosition)</div></div></div>
        </div>
        <div class="col-md-3">
            <div class="card"><div class="card-body"><div class="text-muted">Mortgage</div><div class="h4">@FormatCurrency(summary.CurrentMortgagePosition)</div></div></div>
        </div>
    </div>

    <h2 class="mt-5">Account Overview</h2>
    @if (accountSummaries.Count == 0)
    {
        <div class="alert alert-info" role="status">
            <p>No accounts to display. <a href="/accounts">Add an account</a> to get started.</p>
        </div>
    }
    else
    {
        <!-- Filter form -->
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Filter Accounts</h5>
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label">Account Name</label>
                        <input type="text" class="form-control" placeholder="Search by name..." @bind="filterAccountName" @bind:event="oninput" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Account Type</label>
                        <select class="form-select" @bind="filterAccountType" @bind:event="onchange">
                            <option value="">All Types</option>
                            <option value="Transaction">Transaction</option>
                            <option value="Savings">Savings</option>
                            <option value="CreditCard">Credit Card</option>
                            <option value="Mortgage">Mortgage</option>
                            <option value="Investment">Investment</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-6">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="filterActivity" @bind="filterWithActivityOnly" @bind:event="onchange" />
                            <label class="form-check-label" for="filterActivity">
                                Only show accounts with previous month activity
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetFilters">Clear Filters</button>
                        <span class="ms-3 text-muted">Showing @filteredCount of @accountSummaries.Count account(s)</span>
                    </div>
                </div>
            </div>
        </div>

        @if (filteredCount == 0)
        {
            <div class="alert alert-secondary">No accounts match the current filters.</div>
        }
        else
        {
            <div class="table-responsive">
            <table class="table table-striped table-hover" role="grid">
                <thead>
                    <tr>
                        <th>
                            <a @onclick="() => UpdateSortBy(SortColumn.AccountName)" 
                               style="cursor: pointer;"
                               role="button"
                               tabindex="0"
                               @onkeydown="(KeyboardEventArgs e) => HandleSortKeydown(e, SortColumn.AccountName)"
                               aria-sort="@GetAriaSort(SortColumn.AccountName)">
                                Account @(currentSort == SortColumn.AccountName ? (sortAscending ? "▲" : "▼") : "")
                            </a>
                        </th>
                        <th>
                            <a @onclick="@(() => UpdateSortBy(SortColumn.AccountType))" 
                               style="cursor: pointer; text-decoration: none;"
                               role="button"
                               tabindex="0"
                               @onkeydown="(KeyboardEventArgs e) => HandleSortKeydown(e, SortColumn.AccountType)"
                               aria-sort="@GetAriaSort(SortColumn.AccountType)">
                                Type @(currentSort == SortColumn.AccountType ? (sortAscending ? "▲" : "▼") : "")
                            </a>
                        </th>
                        <th class="text-end">
                            <a @onclick="() => UpdateSortBy(SortColumn.CurrentPosition)" 
                               style="cursor: pointer;"
                               role="button"
                               tabindex="0"
                               @onkeydown="(KeyboardEventArgs e) => HandleSortKeydown(e, SortColumn.CurrentPosition)"
                               aria-sort="@GetAriaSort(SortColumn.CurrentPosition)">
                                Current Position @(currentSort == SortColumn.CurrentPosition ? (sortAscending ? "▲" : "▼") : "")
                            </a>
                        </th>
                        <th class="text-end">
                            <a @onclick="@(() => UpdateSortBy(SortColumn.PreviousMonthIncome))" 
                               style="cursor: pointer; text-decoration: none;"
                               role="button"
                               tabindex="0"
                               @onkeydown="(KeyboardEventArgs e) => HandleSortKeydown(e, SortColumn.PreviousMonthIncome)"
                               aria-sort="@GetAriaSort(SortColumn.PreviousMonthIncome)">
                                Prev Month Income @(currentSort == SortColumn.PreviousMonthIncome ? (sortAscending ? "▲" : "▼") : "")
                            </a>
                        </th>
                        <th class="text-end">
                            <a @onclick="@(() => UpdateSortBy(SortColumn.PreviousMonthExpenses))" 
                               style="cursor: pointer; text-decoration: none;"
                               role="button"
                               tabindex="0"
                               @onkeydown="(KeyboardEventArgs e) => HandleSortKeydown(e, SortColumn.PreviousMonthExpenses)"
                               aria-sort="@GetAriaSort(SortColumn.PreviousMonthExpenses)">
                                Prev Month Expenses @(currentSort == SortColumn.PreviousMonthExpenses ? (sortAscending ? "▲" : "▼") : "")
                            </a>
                        </th>
                        <th class="text-end">
                            <a @onclick="() => UpdateSortBy(SortColumn.PreviousMonthNet)" 
                               style="cursor: pointer;"
                               role="button"
                               tabindex="0"
                               @onkeydown="(KeyboardEventArgs e) => HandleSortKeydown(e, SortColumn.PreviousMonthNet)"
                               aria-sort="@GetAriaSort(SortColumn.PreviousMonthNet)">
                                Prev Month Net @(currentSort == SortColumn.PreviousMonthNet ? (sortAscending ? "▲" : "▼") : "")
                            </a>
                        </th>
                        <th>
                            <a @onclick="() => UpdateSortBy(SortColumn.LastTransaction)" 
                               style="cursor: pointer;"
                               role="button"
                               tabindex="0"
                               @onkeydown="(KeyboardEventArgs e) => HandleSortKeydown(e, SortColumn.LastTransaction)"
                               aria-sort="@GetAriaSort(SortColumn.LastTransaction)">
                                Last Transaction @(currentSort == SortColumn.LastTransaction ? (sortAscending ? "▲" : "▼") : "")
                            </a>
                        </th>
                        <th class="text-center">Transactions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var summary in GetFilteredAndSortedSummaries())
                    {
                        <tr class="account-row" @onclick="() => NavigateToAccount(summary.AccountId)" role="button" tabindex="0" @onkeydown="e => HandleKeyDown(e, summary.AccountId)">
                            <td>
                                <a href="/accounts/@summary.AccountId/transactions" class="account-link">
                                    @summary.AccountName
                                </a>
                            </td>
                            <td>@summary.AccountType</td>
                            <td class="text-end">
                                @if (summary.IsLiability)
                                {
                                    <span class="badge bg-danger">@FormatCurrency(summary.CurrentPosition) owing</span>
                                }
                                else
                                {
                                    <span>@FormatCurrency(summary.CurrentPosition)</span>
                                }
                            </td>
                            <td class="text-end">@FormatPreviousMonthValue(summary.PreviousMonthIncome, summary.TransactionCount)</td>
                            <td class="text-end">@FormatPreviousMonthValue(summary.PreviousMonthExpenses, summary.TransactionCount)</td>
                            <td class="text-end">
                                @if (summary.PreviousMonthTransactionCount == 0)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else if (summary.PreviousMonthNet >= 0)
                                {
                                    <span class="text-success fw-bold">@FormatCurrency(summary.PreviousMonthNet)</span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold">@FormatCurrency(summary.PreviousMonthNet)</span>
                                }
                            </td>
                            <td>@FormatDate(summary.LastTransactionDate)</td>
                            <td class="text-center">@summary.TransactionCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
    }
}

<style>
    .account-row {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .account-row:hover {
        background-color: #f8f9fa;
    }

    .account-row:focus {
        outline: 2px solid #0d6efd;
        outline-offset: -2px;
        background-color: #e7f1ff;
    }

    .account-link {
        text-decoration: none;
        color: inherit;
        font-weight: 500;
    }

    .account-link:hover,
    .account-link:focus {
        text-decoration: underline;
        color: #0d6efd;
    }

    .account-link:focus {
        outline: 2px solid #0d6efd;
        border-radius: 0.25rem;
    }

    th a {
        color: inherit;
        text-decoration: none;
    }

    th a:hover {
        text-decoration: underline;
        color: #0d6efd;
    }

    th a:focus {
        outline: 2px solid #0d6efd;
        border-radius: 0.25rem;
    }

    /* Make table more compact and readable */
    .table {
        font-size: 0.95rem;
    }

    .table thead th {
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
        font-weight: 600;
        white-space: nowrap;
    }

    .table td:where(.text-end) {
        min-width: 100px;
    }

    /* Ensure badges don't wrap */
    .badge {
        white-space: nowrap;
    }
</style>

@code {
    private enum SortColumn
    {
        AccountName,
        AccountType,
        CurrentPosition,
        PreviousMonthIncome,
        PreviousMonthExpenses,
        PreviousMonthNet,
        LastTransaction
    }

    private DashboardSummaryModel summary = new(0m, 0m, 0m, 0m);
    private List<AccountDashboardSummaryModel> accountSummaries = [];
    private bool isLoading = true;
    private string? loadError;
    private SortColumn currentSort = SortColumn.AccountName;
    private bool sortAscending = true;

    // Filter fields
    private string filterAccountName = "";
    private string filterAccountType = "";
    private bool filterWithActivityOnly = false;
    private int filteredCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            summary = await ApiClient.GetDashboardSummaryAsync();
            accountSummaries = (await ApiClient.GetAccountSummariesAsync()).ToList();
            UpdateFilteredCount();
        }
        catch (Exception ex)
        {
            loadError = $"Unable to load dashboard: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void UpdateSortBy(SortColumn column)
    {
        if (currentSort == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSort = column;
            sortAscending = true;
        }
    }

    private decimal NormalizeLiabilityPosition(AccountDashboardSummaryModel summary)
    {
        // For sorting liabilities: if IsLiability, negate the value so liabilities
        // sort correctly (higher debt = lower sort value). This preserves semantics.
        return summary.IsLiability ? -summary.CurrentPosition : summary.CurrentPosition;
    }

    private IEnumerable<AccountDashboardSummaryModel> GetFilteredAndSortedSummaries()
    {
        // Apply filters
        var filtered = accountSummaries
            .Where(s => string.IsNullOrWhiteSpace(filterAccountName) || 
                       s.AccountName.Contains(filterAccountName, StringComparison.OrdinalIgnoreCase))
            .Where(s => string.IsNullOrWhiteSpace(filterAccountType) || 
                       s.AccountType.Equals(filterAccountType, StringComparison.OrdinalIgnoreCase))
            .Where(s => !filterWithActivityOnly || s.PreviousMonthTransactionCount > 0)
            .ToList();

        // Apply sorting with deterministic secondary ordering by AccountName
        return currentSort switch
        {
            SortColumn.AccountName =>
                sortAscending
                    ? filtered.OrderBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => s.AccountName),

            SortColumn.AccountType =>
                sortAscending
                    ? filtered.OrderBy(s => s.AccountType).ThenBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => s.AccountType).ThenBy(s => s.AccountName),

            SortColumn.CurrentPosition =>
                sortAscending
                    ? filtered.OrderBy(s => NormalizeLiabilityPosition(s)).ThenBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => NormalizeLiabilityPosition(s)).ThenBy(s => s.AccountName),

            SortColumn.PreviousMonthIncome =>
                sortAscending
                    ? filtered.OrderBy(s => s.PreviousMonthIncome).ThenBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => s.PreviousMonthIncome).ThenBy(s => s.AccountName),

            SortColumn.PreviousMonthExpenses =>
                sortAscending
                    ? filtered.OrderBy(s => s.PreviousMonthExpenses).ThenBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => s.PreviousMonthExpenses).ThenBy(s => s.AccountName),

            SortColumn.PreviousMonthNet =>
                sortAscending
                    ? filtered.OrderBy(s => s.PreviousMonthNet).ThenBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => s.PreviousMonthNet).ThenBy(s => s.AccountName),

            SortColumn.LastTransaction =>
                sortAscending
                    ? filtered.OrderBy(s => s.LastTransactionDate).ThenBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => s.LastTransactionDate).ThenBy(s => s.AccountName),

            _ => filtered
        };
    }

    private void ApplyFilters()
    {
        UpdateFilteredCount();
    }

    private void ResetFilters()
    {
        filterAccountName = "";
        filterAccountType = "";
        filterWithActivityOnly = false;
        UpdateFilteredCount();
    }

    private void UpdateFilteredCount()
    {
        filteredCount = GetFilteredAndSortedSummaries().Count();
    }

    private void NavigateToAccount(Guid accountId)
    {
        // Navigate to the account transactions detail view
        Navigation.NavigateTo($"/accounts/{accountId}/transactions");
    }

    private void HandleKeyDown(KeyboardEventArgs e, Guid accountId)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            NavigateToAccount(accountId);
        }
    }

    private void HandleSortKeydown(KeyboardEventArgs e, SortColumn column)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            UpdateSortBy(column);
        }
    }

    private string GetAriaSort(SortColumn column)
    {
        if (currentSort != column)
            return "none";

        return sortAscending ? "ascending" : "descending";
    }

    private static string FormatCurrency(decimal amount)
    {
        return amount.ToString("C");
    }

    private static string FormatPreviousMonthValue(decimal amount, int totalTransactionCount)
    {
        // If there are no transactions at all, show a dash
        if (totalTransactionCount == 0)
        {
            return "—";
        }

        // Otherwise format as currency (may be 0 if no activity in previous month)
        return amount.ToString("C");
    }

    private static string FormatDate(DateOnly? date)
    {
        return date.HasValue ? date.Value.ToString("dd/MM/yyyy") : "-";
    }
}
