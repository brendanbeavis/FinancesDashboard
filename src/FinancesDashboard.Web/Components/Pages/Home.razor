    private void UpdateSortBy(SortColumn column)
    {
        if (currentSort == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSort = column;
            sortAscending = true;
        }
    }

    private decimal NormalizeLiabilityPosition(AccountDashboardSummaryModel summary)
    {
        return summary.IsLiability ? -summary.CurrentPosition : summary.CurrentPosition;
    }

    private IEnumerable<AccountDashboardSummaryModel> GetFilteredAndSortedSummaries()
    {
        var filtered = accountSummaries
            .Where(s => string.IsNullOrWhiteSpace(filterAccountName) ||
                        s.AccountName.Contains(filterAccountName, StringComparison.OrdinalIgnoreCase))
            .Where(s => string.IsNullOrWhiteSpace(filterAccountType) ||
                        s.AccountType.Equals(filterAccountType, StringComparison.OrdinalIgnoreCase))
            .Where(s => !filterWithActivityOnly || s.PreviousMonthTransactionCount > 0)
            .ToList();

        return currentSort switch
        {
            SortColumn.AccountName =>
                sortAscending
                    ? filtered.OrderBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => s.AccountName),

            SortColumn.AccountType =>
                sortAscending
                    ? filtered.OrderBy(s => s.AccountType).ThenBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => s.AccountType).ThenBy(s => s.AccountName),

            SortColumn.CurrentPosition =>
                sortAscending
                    ? filtered.OrderBy(s => NormalizeLiabilityPosition(s)).ThenBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => NormalizeLiabilityPosition(s)).ThenBy(s => s.AccountName),

            SortColumn.PreviousMonthIncome =>
                sortAscending
                    ? filtered.OrderBy(s => s.PreviousMonthIncome).ThenBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => s.PreviousMonthIncome).ThenBy(s => s.AccountName),

            SortColumn.PreviousMonthExpenses =>
                sortAscending
                    ? filtered.OrderBy(s => s.PreviousMonthExpenses).ThenBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => s.PreviousMonthExpenses).ThenBy(s => s.AccountName),

            SortColumn.PreviousMonthNet =>
                sortAscending
                    ? filtered.OrderBy(s => s.PreviousMonthNet).ThenBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => s.PreviousMonthNet).ThenBy(s => s.AccountName),

            SortColumn.LastTransaction =>
                sortAscending
                    ? filtered.OrderBy(s => s.LastTransactionDate).ThenBy(s => s.AccountName)
                    : filtered.OrderByDescending(s => s.LastTransactionDate).ThenBy(s => s.AccountName),

            _ => filtered
        };
    }

    private void ApplyFilters()
    {
        UpdateFilteredCount();
    }

    private void ResetFilters()
    {
        filterAccountName = "";
        filterAccountType = "";
        filterWithActivityOnly = false;
        UpdateFilteredCount();
    }

    private void UpdateFilteredCount()
    {
        filteredCount = GetFilteredAndSortedSummaries().Count();
    }

    private void NavigateToAccount(Guid accountId)
    {
        Navigation.NavigateTo($"/accounts/{accountId}/transactions");
    }

    private void HandleKeyDown(KeyboardEventArgs e, Guid accountId)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            NavigateToAccount(accountId);
        }
    }

    private void HandleSortKeydown(KeyboardEventArgs e, SortColumn column)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            UpdateSortBy(column);
        }
    }

    private string GetAriaSort(SortColumn column)
    {
        if (currentSort != column)
        {
            return "none";
        }

        return sortAscending ? "ascending" : "descending";
    }

    private static decimal GetNetContribution(AccountDashboardSummaryModel summary, decimal rawBalance)
    {
        return summary.IsLiability
            ? -Math.Abs(rawBalance)
            : rawBalance;
    }

    private static string GetTrendSeriesName(AccountDashboardSummaryModel summary)
    {
        return summary.IsLiability
            ? $"{summary.AccountName} (owing)"
            : summary.AccountName;
    }

    private static IReadOnlyList<T> Downsample<T>(IReadOnlyList<T> items, int maxPoints)
    {
        if (items.Count <= maxPoints)
        {
            return items;
        }

        var step = (int)Math.Ceiling(items.Count / (double)maxPoints);
        var sampled = items
            .Where((_, index) => index % step == 0)
            .ToList();

        if (!EqualityComparer<T>.Default.Equals(sampled[^1], items[^1]))
        {
            sampled.Add(items[^1]);
        }

        return sampled;
    }

    private IEnumerable<DashboardAccountTrendChartPointModel> GetTrendSeriesPoints(string seriesName)
    {
        return accountTrendPoints.Where(point => point.AccountName == seriesName);
    }

    private decimal GetSignedTotalByType(params string[] accountTypes)
    {
        return accountSummaries
            .Where(summary => accountTypes.Contains(summary.AccountType, StringComparer.OrdinalIgnoreCase))
            .Sum(summary => summary.IsLiability ? -Math.Abs(summary.CurrentPosition) : summary.CurrentPosition);
    }

    private int GetAccountTypeCount(params string[] accountTypes)
    {
        return accountSummaries.Count(summary => summary.IsActive && accountTypes.Contains(summary.AccountType, StringComparer.OrdinalIgnoreCase));
    }

    private string GetTypeCountSupportingText(string accountType, string label)
    {
        var count = GetAccountTypeCount(accountType);
        return count == 0
            ? $"No active {label} accounts yet."
            : $"{count} active {label} account(s).";
    }

    private string GetNetPositionSupportingText()
    {
        var activeAccountCount = accountSummaries.Count(summary => summary.IsActive);
        var accountText = activeAccountCount == 1
            ? "1 active account tracked"
            : $"{activeAccountCount} active accounts tracked";

        return latestObservedHistoryDate.HasValue
            ? $"{accountText} · observed through {latestObservedHistoryDate.Value:dd MMM yyyy}"
            : accountText;
    }

    private string GetCashSupportingText()
    {
        var monthlyNet = accountSummaries
            .Where(summary => summary.IsActive && summary.AccountType is "Transaction" or "Savings")
            .Sum(summary => summary.PreviousMonthNet);

        return accountSummaries.Any(summary => summary.IsActive && summary.AccountType is "Transaction" or "Savings")
            ? $"Last completed month: {FormatCurrency(monthlyNet)} net."
            : "Transaction and savings balances only.";
    }

    private string GetLiabilitySupportingText(string accountType, string label)
    {
        var count = GetAccountTypeCount(accountType);
        return count == 0
            ? $"No active {label} accounts yet."
            : $"{count} active {label} account(s) owing.";
    }

    private static string FormatCurrency(decimal amount)
    {
        return amount.ToString("C");
    }

    private static string GetSignedValueClass(decimal amount)
    {
        if (amount > 0)
        {
            return "fd-value--positive";
        }

        if (amount < 0)
        {
            return "fd-value--negative";
        }

        return "fd-value--strong";
    }

    private static string GetAccountTypeChipClass(string accountType)
    {
        return accountType switch
        {
            "Mortgage" or "CreditCard" => "fd-status-chip fd-status-chip--negative",
            "Savings" or "Investment" => "fd-status-chip fd-status-chip--positive",
            _ => "fd-status-chip fd-status-chip--muted"
        };
    }

    private static string FormatPreviousMonthValue(decimal amount, int totalTransactionCount)
    {
        if (totalTransactionCount == 0)
        {
            return "—";
        }

        return amount.ToString("C");
    }

    private static string FormatDate(DateOnly? date)
    {
        return date.HasValue ? date.Value.ToString("dd MMM yyyy") : "—";
    }
