    private static string GetForecastStatusValueClass(string? status)
    {
        return status switch
        {
            "PaidOff" => "fd-value--positive",
            "Unavailable" => "fd-value--muted",
            _ => "fd-value--strong"
        };
    }

    private static string GetForecastStatusClass(string? status)
    {
        return status switch
        {
            "PaidOff" => "fd-forecast-status--positive",
            "SafetyLimitReached" or "NonAmortising" => "fd-forecast-status--warning",
            "Unavailable" => "fd-forecast-status--muted",
            _ => string.Empty
        };
    }

    private static string FormatCurrency(decimal amount)
    {
        return amount.ToString("C0");
    }

    private static string GetFrequencyLabel(int repaymentsPerYear)
    {
        return repaymentsPerYear switch
        {
            1 => "Annually",
            2 => "Bi-annually",
            4 => "Quarterly",
            12 => "Monthly",
            24 => "Bi-weekly",
            26 => "Bi-weekly (26x)",
            52 => "Weekly",
            _ => $"{repaymentsPerYear}x per year"
        };
    }

    private static string GetForecastStatusLabel(string? status)
    {
        return status switch
        {
            "PaidOff" => "Will be paid off",
            "NonAmortising" => "Repayment does not reduce principal",
            "SafetyLimitReached" => "Projection limit reached",
            "Unavailable" => "Waiting for repayment pattern or override",
            _ => "Unknown"
        };
    }
}
