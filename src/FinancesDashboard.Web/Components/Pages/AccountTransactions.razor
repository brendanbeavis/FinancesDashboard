@page "/accounts/{AccountId:guid}/transactions"

@inject FinancesApiClient ApiClient
@inject NavigationManager NavigationManager

<PageTitle>Account Transactions</PageTitle>

<PageHeader Eyebrow="Transactions" Title="@($"{AccountName} transactions")" Description="Review imported transaction history, filter the feed, and manage individual entries with confidence.">
    <Actions>
        <a href="/accounts" class="btn btn-outline-secondary">Back to Accounts</a>
    </Actions>
</PageHeader>

@if (IsLoadingSummary)
{
    <div class="row g-3 mb-4">
        @for (var index = 0; index < 2; index++)
        {
            <div class="col-md-6">
                <div class="fd-skeleton-card h-100">
                    <div class="fd-skeleton-stack">
                        <SkeletonBlock Height="0.85rem" Width="42%" />
                        <SkeletonBlock Height="2.1rem" Width="78%" />
                        <SkeletonBlock Height="0.8rem" Width="66%" />
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrWhiteSpace(SummaryError))
{
    <div class="alert alert-warning">@SummaryError</div>
}
else if (DashboardSummary is not null)
{
    <div class="row g-3 mb-4 fd-fade-in fd-dashboard-support-grid">
        <div class="col-12 col-lg-6">
            <MetricCard Label="Overall net position"
                        Value="@FormatCurrency(DashboardSummary.CurrentNetPosition)"
                        ValueClass="@GetSignedValueClass(DashboardSummary.CurrentNetPosition)"
                        SupportingText="Live position across every tracked account."
                        AccentClass="fd-metric-card--success" />
        </div>
        <div class="col-12 col-lg-6">
            <MetricCard Label="Account position"
                        Value="@(SelectedAccountSummary is not null ? $"{FormatCurrency(SelectedAccountSummary.CurrentPosition)}{(SelectedAccountSummary.IsLiability ? " owing" : string.Empty)}" : "—")"
                        ValueClass="@(SelectedAccountSummary is null ? "fd-value--muted" : (SelectedAccountSummary.IsLiability ? "fd-value--negative" : "fd-value--positive"))"
                        SupportingText="@(SelectedAccountSummary?.IsLiability == true ? "Liability balance for this account." : "Current observed position for this account.")"
                        AccentClass="@(SelectedAccountSummary?.IsLiability == true ? "fd-metric-card--danger" : null)" />
        </div>
    </div>
}

<div class="fd-section-surface mb-4 fd-section-refresh @(IsLoading ? "fd-section-refresh--busy" : string.Empty)">
    <div class="fd-section-title">
        <div>
            <h2>Filter and sort</h2>
            <p>Narrow the transaction feed by date, amount, direction, and description while preserving imported bank balances.</p>
        </div>
        <div class="fd-status-chip fd-status-chip--muted">@transactions.Count transaction(s)</div>
    </div>

    <form @onsubmit="ApplyFilters">
        <div class="fd-toolbar-grid fd-toolbar-grid--filters">
            <div class="fd-toolbar-span-3">
                <label class="form-label">From Date</label>
                <input type="date" class="form-control" @bind="FilterDateFrom" />
            </div>
            <div class="fd-toolbar-span-3">
                <label class="form-label">To Date</label>
                <input type="date" class="form-control" @bind="FilterDateTo" />
            </div>
            <div class="fd-toolbar-span-6">
                <label class="form-label">Description</label>
                <input type="text" class="form-control" placeholder="Contains..." @bind="FilterDescription" />
            </div>
            <div class="fd-toolbar-span-2">
                <label class="form-label">Min Amount</label>
                <input type="number" step="0.01" class="form-control" @bind="FilterMinAmount" />
            </div>
            <div class="fd-toolbar-span-2">
                <label class="form-label">Max Amount</label>
                <input type="number" step="0.01" class="form-control" @bind="FilterMaxAmount" />
            </div>
            <div class="fd-toolbar-span-2">
                <label class="form-label">Direction</label>
                <select class="form-select" @bind="FilterDirection">
                    <option value="All">All</option>
                    <option value="Positive">Income</option>
                    <option value="Negative">Expense</option>
                </select>
            </div>
            <div class="fd-toolbar-span-2">
                <label class="form-label">Sort By</label>
                <select class="form-select" @bind="SortColumn">
                    <option value="Date">Date</option>
                    <option value="Description">Description</option>
                    <option value="Amount">Amount</option>
                    <option value="BankBalance">Balance</option>
                </select>
            </div>
            <div class="fd-toolbar-span-2">
                <label class="form-label">Order</label>
                <select class="form-select" @bind="SortOrder">
                    <option value="Desc">Desc</option>
                    <option value="Asc">Asc</option>
                </select>
            </div>
            <div class="fd-toolbar-span-2 d-grid">
                <button type="submit" class="btn btn-primary">Apply</button>
            </div>
        </div>
        <div class="fd-toolbar-summary mt-3">
            <div class="fd-semantic-note">Filter by date, direction, and description while keeping the imported bank balance context visible.</div>
            <div class="fd-toolbar-actions">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ResetFilters">Clear Filters</button>
                @if (transactions.Count > 0)
                {
                    <span class="fd-semantic-note">Visible total: <span class="fw-semibold @GetSignedValueClass(transactions.Sum(t => t.Amount))">@FormatCurrency(transactions.Sum(t => t.Amount))</span></span>
                }
            </div>
        </div>
    </form>
</div>

@if (IsLoading)
{
    <div class="fd-section-surface fd-table-surface">
        <div class="p-4 fd-skeleton-table">
            @for (var row = 0; row < 6; row++)
            {
                <div class="fd-skeleton-table__row">
                    <SkeletonBlock Height="1.1rem" Width="100%" />
                    <SkeletonBlock Height="1.1rem" Width="100%" />
                    <SkeletonBlock Height="1.1rem" Width="100%" />
                    <SkeletonBlock Height="1.1rem" Width="100%" />
                    <SkeletonBlock Height="1.1rem" Width="100%" />
                </div>
            }
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(LoadError))
{
    <div class="alert alert-danger">@LoadError</div>
}
else if (transactions.Count == 0)
{
    <div class="alert alert-secondary">No transactions found for this account.</div>
}
else
{
    <div class="fd-section-surface fd-table-surface fd-fade-in">
        <div class="table-responsive">
            <table class="table table-hover align-middle fd-transaction-table">
                <thead>
                    <tr>
                        <th><a href="#" class="fd-table-sort" @onclick:preventDefault @onclick="@(() => UpdateSortAsync("Date"))">Date @GetSortIndicator("Date")</a></th>
                        <th><a href="#" class="fd-table-sort" @onclick:preventDefault @onclick="@(() => UpdateSortAsync("Description"))">Description @GetSortIndicator("Description")</a></th>
                        <th class="text-end"><a href="#" class="fd-table-sort" @onclick:preventDefault @onclick="@(() => UpdateSortAsync("Amount"))">Amount @GetSortIndicator("Amount")</a></th>
                        <th class="text-end"><a href="#" class="fd-table-sort" @onclick:preventDefault @onclick="@(() => UpdateSortAsync("BankBalance"))">Bank balance @GetSortIndicator("BankBalance")</a></th>
                        <th>Imported</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in transactions)
                    {
                        <tr>
                            <td>
                                <div class="fd-transaction-date">
                                    <div class="fd-transaction-date__title">@transaction.Date.ToString("dd MMM yyyy")</div>
                                    <div class="fd-transaction-date__meta">Transaction date</div>
                                </div>
                            </td>
                            <td>
                                <div class="fd-transaction-description">
                                    <div class="fd-transaction-description__title">@transaction.Description</div>
                                    <div class="fd-transaction-description__meta">@transaction.ImportedUtc.ToString("dd MMM yyyy 'at' HH:mm")</div>
                                </div>
                            </td>
                            <td class="text-end">
                                <span class="fw-semibold @GetSignedValueClass(transaction.Amount)">
                                    @transaction.Amount.ToString("C")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="fd-transaction-balance">
                                    <div class="fd-transaction-balance__title @GetSignedValueClass(transaction.BankBalance)">@transaction.BankBalance.ToString("C")</div>
                                    <div class="fd-transaction-balance__meta">Running bank balance</div>
                                </div>
                            </td>
                            <td><span class="fd-semantic-note">@transaction.ImportedUtc.ToString("g")</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => OnDeleteClick(transaction)" title="Delete this transaction">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<TransactionConfirmDeleteModal 
    IsVisible="ShowDeleteModal"
    Transaction="SelectedTransaction"
    OnDeleteAsync="HandleConfirmDelete"
    OnClose="HandleDeleteModalClose" />

@code {
    [Parameter]
    public Guid AccountId { get; set; }

    private List<TransactionModel> transactions = [];
    private bool IsLoading = true;
    private string? LoadError;
    private string AccountName = "Unknown";
    private bool ShowDeleteModal = false;
    private TransactionModel? SelectedTransaction;

    // Summary fields
    private DashboardSummaryModel? DashboardSummary;
    private AccountDashboardSummaryModel? SelectedAccountSummary;
    private bool IsLoadingSummary = false;
    private string? SummaryError;

    // Filter fields
    private DateTime? FilterDateFrom;
    private DateTime? FilterDateTo;
    private string FilterDescription = "";
    private decimal? FilterMinAmount;
    private decimal? FilterMaxAmount;
    private string FilterDirection = "All";
    private string SortColumn = "Date";
    private string SortOrder = "Desc";

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
        await LoadSummariesAsync();
    }

    private async Task LoadAccountsAsync()
    {
        IsLoading = true;
        LoadError = null;

        try
        {
            var accounts = await ApiClient.GetAccountsAsync();
            var account = accounts.FirstOrDefault(a => a.Id == AccountId);

            if (account is null)
            {
                LoadError = "Account not found.";
                return;
            }

            AccountName = account.Name;
            await LoadTransactionsAsync();
        }
        catch (Exception ex)
        {
            LoadError = $"Unable to load transactions: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadTransactionsAsync()
    {
        try
        {
            var dateFrom = FilterDateFrom.HasValue ? DateOnly.FromDateTime(FilterDateFrom.Value) : (DateOnly?)null;
            var dateTo = FilterDateTo.HasValue ? DateOnly.FromDateTime(FilterDateTo.Value) : (DateOnly?)null;

            transactions = (await ApiClient.GetAccountTransactionsAsync(
                AccountId,
                dateFrom,
                dateTo,
                string.IsNullOrWhiteSpace(FilterDescription) ? null : FilterDescription,
                FilterMinAmount,
                FilterMaxAmount,
                FilterDirection == "All" ? null : FilterDirection,
                SortColumn,
                SortOrder)).ToList();
        }
        catch (Exception ex)
        {
            LoadError = $"Unable to load transactions: {ex.Message}";
        }
    }

    private async Task LoadSummariesAsync()
    {
        IsLoadingSummary = true;
        SummaryError = null;

        try
        {
            DashboardSummary = await ApiClient.GetDashboardSummaryAsync();
            var accountSummaries = await ApiClient.GetAccountSummariesAsync();
            SelectedAccountSummary = accountSummaries.FirstOrDefault(s => s.AccountId == AccountId);
        }
        catch (Exception ex)
        {
            SummaryError = $"Unable to load financial summary: {ex.Message}";
        }
        finally
        {
            IsLoadingSummary = false;
        }
    }

    private void OnDeleteClick(TransactionModel transaction)
    {
        SelectedTransaction = transaction;
        ShowDeleteModal = true;
    }

    private async Task HandleConfirmDelete()
    {
        if (SelectedTransaction is null)
            return;

        try
        {
            await ApiClient.DeleteTransactionAsync(SelectedTransaction.Id);
            transactions.Remove(SelectedTransaction);
            ShowDeleteModal = false;
            SelectedTransaction = null;
            await LoadSummariesAsync();
        }
        catch (Exception ex)
        {
            LoadError = $"Unable to delete transaction: {ex.Message}";
        }
    }

    private Task HandleDeleteModalClose(bool cancelled)
    {
        ShowDeleteModal = false;
        SelectedTransaction = null;
        return Task.CompletedTask;
    }

    private async Task ApplyFilters()
    {
        IsLoading = true;
        await LoadTransactionsAsync();
        IsLoading = false;
    }

    private async Task ResetFilters()
    {
        FilterDateFrom = null;
        FilterDateTo = null;
        FilterDescription = "";
        FilterMinAmount = null;
        FilterMaxAmount = null;
        FilterDirection = "All";
        SortColumn = "Date";
        SortOrder = "Desc";
        await ApplyFilters();
    }

    private async Task UpdateSortAsync(string column)
    {
        if (SortColumn == column)
        {
            SortOrder = SortOrder == "Desc" ? "Asc" : "Desc";
        }
        else
        {
            SortColumn = column;
            SortOrder = "Desc";
        }

        await ApplyFilters();
    }

    private string GetSortIndicator(string column)
    {
        if (SortColumn != column)
            return "";
        return SortOrder == "Asc" ? "↑" : "↓";
    }

    private static string GetSignedValueClass(decimal value)
    {
        if (value > 0)
        {
            return "fd-value--positive";
        }

        if (value < 0)
        {
            return "fd-value--negative";
        }

        return "fd-value--strong";
    }

    private string FormatCurrency(decimal value)
    {
        return value.ToString("C");
    }
}
