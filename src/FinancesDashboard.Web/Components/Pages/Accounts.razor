@page "/accounts"

@inject FinancesApiClient ApiClient
@inject NavigationManager NavigationManager

<PageTitle>Accounts</PageTitle>

<PageHeader Eyebrow="Data Sources" Title="Accounts" Description="Manage the accounts that power reporting, imports, and mortgage analysis.">
    <Actions>
        <button class="btn btn-success" @onclick="OnAddAccountClick">+ Add Account</button>
    </Actions>
</PageHeader>

@if (isLoading)
{
    <div class="fd-section-surface"><em>Loading accounts...</em></div>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}
else if (accounts.Count == 0)
{
    <div class="alert alert-secondary">No accounts yet. Click "Add Account" to create one.</div>
}
else
{
    <div class="fd-section-surface fd-table-surface">
        <div class="fd-section-title px-4 pt-4 pb-2">
            <div>
                <h2>Account register</h2>
                <p>Each account is the source of reporting, transaction drill-downs, and mortgage analysis.</p>
            </div>
            <div class="fd-status-chip fd-status-chip--muted">@accounts.Count account(s) · @accounts.Count(a => a.IsActive) active</div>
        </div>

        <div class="px-4 pb-3 fd-semantic-note">Inactive accounts remain visible for review, but they are excluded from active reporting.</div>

        <div class="table-responsive">
            <table class="table table-hover align-middle fd-account-list-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in accounts)
                    {
                        <tr>
                            <td>
                                <div class="fd-account-name">
                                    <div class="fd-account-name__title">@account.Name</div>
                                    <div class="fd-account-name__meta">@account.Type account · @(account.IsActive ? "included in reporting" : "review only")</div>
                                </div>
                            </td>
                            <td><span class="@GetAccountTypeChipClass(account.Type)">@account.Type</span></td>
                            <td>
                                <span class="fd-status-chip @(account.IsActive ? "fd-status-chip--positive" : "fd-status-chip--muted")">@(account.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2 flex-wrap justify-content-end fd-account-actions">
                                    <button class="btn btn-sm btn-primary" @onclick="() => OnEditClick(account)">Edit</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OnViewClick(account)">View Transactions</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OnImportClick(account)">Import Data</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<CreateAccountModal 
    IsVisible="showCreateModal"
    AccountTypes="accountTypes"
    OnCreateAsync="OnCreateAccount"
    OnClose="OnCreateClose" />

<EditAccountModal 
    Account="selectedAccount" 
    IsVisible="showEditModal"
    OnClose="OnEditClose"
    OnSaveAsync="OnEditSave"
    OnDeleteAsync="OnEditDelete" />

@code {
    private readonly string[] accountTypes = ["Transaction", "Savings", "CreditCard", "Mortgage", "Investment", "Other"];

    private List<AccountModel> accounts = [];
    private bool isLoading = true;
    private string? loadError;

    private AccountModel? selectedAccount;
    private bool showEditModal;
    private bool showCreateModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var result = await ApiClient.GetAccountsAsync();
            accounts = result.OrderBy(account => account.Name).ToList();
        }
        catch (Exception ex)
        {
            loadError = $"Unable to load accounts: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnAddAccountClick()
    {
        showCreateModal = true;
    }

    private async Task OnCreateAccount((string Name, string Type) values)
    {
        try
        {
            var request = new CreateAccountRequestModel(values.Name, values.Type);
            var created = await ApiClient.CreateAccountAsync(request);
            accounts.Add(created);
            accounts = accounts.OrderBy(account => account.Name).ToList();
            showCreateModal = false;
        }
        catch (Exception ex)
        {
            loadError = $"Unable to create account: {ex.Message}";
        }
    }

    private Task OnCreateClose()
    {
        showCreateModal = false;
        return Task.CompletedTask;
    }

    private void OnEditClick(AccountModel account)
    {
        selectedAccount = account;
        showEditModal = true;
    }

    private async Task OnEditSave((string Name, bool IsActive) values)
    {
        if (selectedAccount is null)
            return;

        try
        {
            var request = new UpdateAccountRequestModel(values.Name, values.IsActive);
            var updated = await ApiClient.UpdateAccountAsync(selectedAccount.Id, request);

            var index = accounts.FindIndex(a => a.Id == selectedAccount.Id);
            if (index >= 0)
            {
                accounts[index] = updated;
            }

            showEditModal = false;
            selectedAccount = null;
        }
        catch (Exception ex)
        {
            loadError = $"Unable to update account: {ex.Message}";
        }
    }

    private async Task OnEditDelete()
    {
        if (selectedAccount is null)
            return;

        try
        {
            await ApiClient.DeleteAccountAsync(selectedAccount.Id);
            accounts.RemoveAll(a => a.Id == selectedAccount.Id);
            showEditModal = false;
            selectedAccount = null;
        }
        catch (Exception ex)
        {
            loadError = $"Unable to delete account: {ex.Message}";
        }
    }

    private static string GetAccountTypeChipClass(string accountType)
    {
        return accountType switch
        {
            "Mortgage" or "CreditCard" => "fd-status-chip fd-status-chip--negative",
            "Savings" or "Investment" => "fd-status-chip fd-status-chip--positive",
            _ => "fd-status-chip fd-status-chip--muted"
        };
    }

    private Task OnEditClose(AccountModel? _)
    {
        showEditModal = false;
        selectedAccount = null;
        return Task.CompletedTask;
    }

    private void OnImportClick(AccountModel account)
    {
        NavigationManager.NavigateTo($"/import?accountId={account.Id}");
    }

    private void OnViewClick(AccountModel account)
    {
        NavigationManager.NavigateTo($"/accounts/{account.Id}/transactions");
    }
}
