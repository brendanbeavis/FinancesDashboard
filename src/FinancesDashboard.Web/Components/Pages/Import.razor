@page "/import"

@inject FinancesApiClient ApiClient
@inject ILogger<Import> Logger

<PageTitle>Import</PageTitle>

<h1>Import CSV</h1>

@if (isLoading)
{
    <p><em>Loading accounts...</em></p>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}
else if (accounts.Count == 0)
{
    <div class="alert alert-secondary">
        No accounts available. Create an account first in the Accounts page.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            
            <div class="mb-3">
                <label class="form-label" for="import-account">Account</label>
                <select id="import-account" class="form-select" @bind="selectedAccountId">
                    <option value="">Select an account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Name (@account.Type)</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" for="import-type">Data Type</label>
                <select id="import-type" class="form-select" @bind="selectedImportType">
                    <option value="">Select data type</option>
                    <option value="cba">CBA Bank Account</option>
                    <option value="coles">Coles Credit Card</option>
                </select>
            </div>


            <div class="mb-3">
                <label class="form-label">CSV file</label>
                <InputFile OnChange="OnFileSelected" accept=".csv,text/csv" class="form-control" />
                @if (!string.IsNullOrWhiteSpace(selectedFileName))
                {
                    <div class="form-text">Selected: @selectedFileName</div>
                }
            </div>

            <button class="btn btn-primary" @onclick="ImportAsync" disabled="@isImporting">@(isImporting ? "Importing..." : "Import")</button>

            @if (!string.IsNullOrWhiteSpace(importError))
            {
                <div class="alert alert-danger mt-3">@importError</div>
            }

            @if (importResult is not null)
            {
                <div class="alert alert-info mt-3">
                    <div><strong>Imported:</strong> @importResult.Imported</div>
                    <div><strong>Skipped:</strong> @importResult.Skipped</div>
                    <div><strong>Errors:</strong> @importResult.Errors.Count</div>
                </div>

                @if (importResult.Errors.Count > 0)
                {
                    <ul class="list-group mt-2">
                        @foreach (var error in importResult.Errors)
                        {
                            <li class="list-group-item list-group-item-warning">@error</li>
                        }
                    </ul>
                }
            }
        </div>
    </div>
}

@code {
    private List<AccountModel> accounts = [];
    private bool isLoading = true;
    private bool isImporting;
    private string? loadError;
    private string? importError;
    private string? selectedAccountId;
    private string? selectedImportType;
    private IBrowserFile? pendingFile;
    private byte[]? selectedFileBytes;
    private string? selectedFileName;
    private ImportResultModel? importResult;

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "accountId")]
    public string? AccountIdFromQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var result = await ApiClient.GetAccountsAsync();
            accounts = result.OrderBy(account => account.Name).ToList();

            if (Guid.TryParse(AccountIdFromQuery, out var accountId) && accounts.Any(account => account.Id == accountId))
            {
                selectedAccountId = accountId.ToString();
            }
        }
        catch (Exception ex)
        {
            loadError = $"Unable to load accounts: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task OnFileSelected(InputFileChangeEventArgs args)
    {
        Logger.LogInformation("OnFileSelected: Event fired");

        try
        {
            if (args?.File == null)
            {
                importError = "No file selected";
                pendingFile = null;
                return Task.CompletedTask;
            }

            Logger.LogInformation("OnFileSelected: File detected - Name={FileName}, Size={FileSize}", args.File.Name, args.File.Size);
            pendingFile = args.File;
            selectedFileName = args.File.Name;
            importResult = null;
            importError = null;
            Logger.LogInformation("OnFileSelected: File stored for later reading");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnFileSelected: Exception - {Message}", ex.Message);
            importError = $"Error selecting file: {ex.Message}";
            pendingFile = null;
        }

        return Task.CompletedTask;
    }

    private async Task ReadFileAsync()
    {
        if (pendingFile == null)
        {
            return;
        }

        try
        {
            Logger.LogInformation("ReadFileAsync: Starting for {FileName}", pendingFile.Name);

            const int maxFileSize = 10 * 1024 * 1024; // 10 MB
            if (pendingFile.Size > maxFileSize)
            {
                importError = $"File exceeds 10 MB limit";
                pendingFile = null;
                selectedFileBytes = null;
                return;
            }

            await using var stream = pendingFile.OpenReadStream(maxAllowedSize: maxFileSize);
            Logger.LogInformation("ReadFileAsync: Stream opened");

            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            selectedFileBytes = memoryStream.ToArray();
            importError = null;
            Logger.LogInformation("ReadFileAsync: Complete - {ByteCount} bytes cached", selectedFileBytes.Length);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ReadFileAsync: Failed - {Message}", ex.Message);
            importError = $"Error reading file: {ex.Message}";
            selectedFileBytes = null;
        }
        finally
        {
            pendingFile = null;
        }
    }

    private async Task ImportAsync()
    {
        importError = null;
        importResult = null;

        if (string.IsNullOrWhiteSpace(selectedImportType))
        {
            importError = "Select a data type before importing.";
            return;
        }

        if (!Guid.TryParse(selectedAccountId, out var accountId))
        {
            importError = "Select an account before importing.";
            return;
        }

        if (selectedFileName == null)
        {
            importError = "Select a CSV file before importing.";
            return;
        }

        isImporting = true;

        try
        {
            // If file bytes aren't cached yet, read them now
            if (selectedFileBytes == null || selectedFileBytes.Length == 0)
            {
                Logger.LogInformation("ImportAsync: File not yet read, reading now");
                await ReadFileAsync();
            }

            if (selectedFileBytes == null || selectedFileBytes.Length == 0)
            {
                importError = "Failed to read the selected file.";
                return;
            }

            Logger.LogInformation("ImportAsync: Starting import with {ByteCount} bytes", selectedFileBytes.Length);
            using var stream = new MemoryStream(selectedFileBytes);

            importResult = selectedImportType switch
            {
                "cba" => await ApiClient.ImportCbaAsync(accountId, stream, selectedFileName),
                "coles" => await ApiClient.ImportColesAsync(accountId, stream, selectedFileName),
                _ => throw new InvalidOperationException($"Unknown import type: {selectedImportType}")
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ImportAsync: Failed - {Message}", ex.Message);
            importError = $"Import failed: {ex.Message}";
        }
        finally
        {
            isImporting = false;
            selectedFileBytes = null;
            selectedFileName = null;
        }
    }
}
