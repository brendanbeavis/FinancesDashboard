<div class="fd-section-surface fd-chart-surface @(string.IsNullOrWhiteSpace(Class) ? string.Empty : Class)">
    <SectionHeader Title="@Title" Description="@Description" MetaContent="@MetaContent" Actions="@Actions" />

    @if (!string.IsNullOrWhiteSpace(FeedbackMessage))
    {
        <FeedbackPanel Variant="@FeedbackVariant" Message="@FeedbackMessage" Suggestion="@FeedbackSuggestion" Class="mb-3" />
    }

    @if (ChildContent is not null)
    {
        @ChildContent
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? FeedbackVariant { get; set; }

    [Parameter]
    public string? FeedbackMessage { get; set; }

    [Parameter]
    public string? FeedbackSuggestion { get; set; }

    [Parameter]
    public RenderFragment? MetaContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

@using Microsoft.AspNetCore.Components